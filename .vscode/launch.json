    "version": "0.2.0",
    "configurations": [
        {
            "name": "Leonard",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "test_data.dat",
                "A,B,C,D,E",
                "--smooth=.03"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "EPP Test",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "epp_test.dat",
                "A,B,C,D,E",
                "--smooth=.03",
                "--analysis=0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "Laplace 2D Test",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "laplace_test_2.dat",
                "X,Y",
                "--smooth=.03",
                "--analysis=1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "Laplace 3D Test",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "args": [
                "laplace_test_3.dat",
                "X,Y,Z",
                "--smooth=.03",
                "--analysis=1"
            ],
            "stopAtEntry": false,
            "console": "internalConsole",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Laplace 4D Test",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "laplace_test_4.dat",
                "X,Y,Z,W",
                "--smooth=.03",
                "--grid=32",
                "--analysis=1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "Test Data",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--dimension=5",
                "--normal=10",
                "--events=100000"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        }
    ]
}